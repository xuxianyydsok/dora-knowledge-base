# ---- 依赖 ----
node_modules/
node_modules
.pnp
.pnp.js

# ---- 构建产物 ----
dist/
build/
.output/
.wrangler/
.dev.vars
frontend/dist/
backend/dist/

# ---- pdf.js 附加资源（构建时从 node_modules 拷进 public/，不入库）----
# 169 个 bcmap + 标准字体 + wasm 共约 4MB，由 vite.config.js 的 copy-pdf-assets
# 插件在每次构建时自动生成。提交它们只会让仓库变大且每次升级 pdf.js 都要重传。
frontend/public/pdfjs/

# ---- 环境变量与密钥（严禁入库）----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Wrangler 本地 secret / 状态 ----
.wrangler/
wrangler.toml.local
backend/.dev.vars
.dev.vars

# ---- Supabase 本地配置 ----
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/config.toml.local

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---- 其它 ----
coverage/
.cache/

# ---- 工具产物（herdr 终端把粘贴的临时文件放在这里） ----
.herdr-web-ui/

# ---- MCP 登录凭据（tools/mcp-login.mjs 用）----
# .env.local 存站长邮箱密码；.mcp-token 存登录后的 JWT。
# 两者都绝不允许入库（tools/ 下的脚本会自动读它们）。
.env.local
.mcp-token
